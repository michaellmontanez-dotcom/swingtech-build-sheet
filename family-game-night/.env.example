# ---- Supabase (get these from Supabase Dashboard → Project Settings → API) ----
# Public values (safe to expose to the browser). Both names are read; set the
# NEXT_PUBLIC_* ones for the client, the plain ones are accepted as fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Secret — server only. NEVER expose to the browser. (Settings → API → service_role)
SUPABASE_SERVICE_ROLE=

# Optional: the public origin used to build join links / QR codes.
# On Vercel this is auto-detected; set it only to override.
NEXT_PUBLIC_APP_URL=

# ---- Push notifications ("it's your turn" alerts) — OPTIONAL ----
# A VAPID key pair signs push messages. A working PUBLIC key is baked into the
# app, so you ONLY need to set the matching PRIVATE key below to turn push on.
# To generate your own pair: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
# Optionally override the baked-in public key (must match the private key):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact for push services (some require it):
VAPID_SUBJECT=mailto:you@example.com
