# ── Droplet / n8n config ─ copy to .env next to docker-compose.yml. Do NOT commit. ──

# Public hostname with a valid TLS cert. Telegram webhooks REQUIRE https with a
# trusted cert, so use a real domain pointed at 198.211.114.184.
N8N_HOST=n8n.yourdomain.com

# n8n editor login (Caddy fronts this too).
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_LONG_RANDOM

# Encrypts stored n8n credentials. Generate once: openssl rand -hex 24
N8N_ENCRYPTION_KEY=CHANGE_ME

# ── Values you paste into n8n credentials / the workflow after import ──
# TELEGRAM_BOT_TOKEN   -> n8n "Telegram API" credential
# SUPABASE_URL         -> used by the HTTP Request node (insert job)
# SUPABASE_SERVICE_KEY -> Authorization header on that node
# TELEGRAM_ALLOWED_IDS -> comma-separated numeric user ids, set in the Code node
