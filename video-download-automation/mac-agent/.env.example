# ── Mac agent config ─ copy to .env and fill in. NEVER commit the real .env. ──

# Supabase (same project style as family-game-night). Use the SERVICE ROLE key here:
# the agent runs on your private Mac and needs to update job rows.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Telegram bot token — the agent sends the final "done / failed" confirmation itself,
# so it needs the same token n8n uses. Get it from @BotFather.
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Where finished videos land. Put this INSIDE your OneDrive folder so the OneDrive
# client syncs it automatically — that is the entire "sync to OneDrive" step.
# In Finder, set this folder to "Always Keep on This Device" so 4K files aren't evicted.
LIBRARY_DIR=/Users/michaelmontanez/Library/CloudStorage/OneDrive-Personal/CoachingLibrary

# How often to poll the queue, in seconds.
POLL_INTERVAL_SECONDS=8

# Refuse new downloads when free space on the library disk drops below this (GB).
MIN_FREE_GB=10

# Optional: if YouTube starts asking "confirm you're not a bot", point this at a
# cookies.txt exported from your browser (or use COOKIES_FROM_BROWSER=chrome).
# Leave blank to disable.
COOKIES_FILE=
COOKIES_FROM_BROWSER=
